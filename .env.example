# Cuenta de servicio de runtime (SELECT/INSERT/UPDATE/DELETE solo en tedxumsa).
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/tedxumsa?schema=public"
# Solo para ejecutar migraciones Prisma desde una cuenta propietaria/especializada.
DATABASE_MIGRATION_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/tedxumsa?schema=public"
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"
TRUST_PROXY_HOPS="0"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
# Cuenta inicial de la aplicación; se guarda en la tabla User al ejecutar db:seed-admin.
ADMIN_EMAIL="admin@tedxumsa.org"
ADMIN_PASSWORD="REEMPLAZA_CON_UNA_CLAVE_SEGURA"
# Clave interna para firmar los tokens de sesión; no es la contraseña del administrador.
JWT_SECRET="REEMPLAZA_CON_UN_SECRETO_ALEATORIO_LARGO"
AUTH_COOKIE_SAME_SITE="lax"
# Resend: required to email the satisfaction survey after ending an event.
RESEND_API_KEY="REEMPLAZA_CON_TU_API_KEY"
MAIL_FROM="TEDxUMSA <inscripciones@tu-dominio-verificado.com>"
